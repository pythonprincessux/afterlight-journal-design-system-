/* =========================================================================
   AFTERLIGHT JOURNAL — Design-System Specimen
   Token architecture: primitive → semantic → component
   ========================================================================= */

/* -------------------------------------------------------------------------
   1. PRIMITIVE TOKENS
   Describe WHAT a value is. Never referenced directly by components —
   only semantic tokens are allowed to point at these.
   ------------------------------------------------------------------------- */
:root {
  /* Rich Editorial (default theme) primitives */
  --ivory-100: #f7f3ea;
  --cream-50: #fffdf8;
  --espresso-900: #29221f;
  --taupe-600: #716762;
  --sand-300: #d8cec0;
  --burgundy-600: #7a263a;
  --burgundy-700: #5d1d2c;
  --gold-600: #9a6a16;

  /* Midnight Editorial (alternate theme) primitives */
  --midnight-950: #171719;
  --charcoal-900: #242326;
  --warm-gray-400: #bdb4aa;
  --smoke-700: #514944;
  --rust-500: #c86b46;
  --rust-400: #e1845c;
  --gold-300: #f0c76a;

  /* Spacing primitives — seven-step proportional scale */
  --space-xs: 0.25rem;
  --space-sm: 0.5rem;
  --space-md: 1rem;
  --space-lg: 1.5rem;
  --space-xl: 2rem;
  --space-2xl: 3rem;
  --space-3xl: 4rem;

  /* Radius primitives */
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;

  /* Elevation primitives — kept to two levels on purpose */
  --elevation-low: 0 1px 3px rgb(41 34 31 / 0.12);
  --elevation-mid: 0 4px 12px rgb(41 34 31 / 0.14);

  /* Typography primitives */
  --font-display: "Libre Baskerville", Georgia, "Times New Roman", serif;
  --font-body: "Inter", Arial, Helvetica, sans-serif;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;

  --text-xs: 0.75rem;
  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.5rem;
  --text-2xl: clamp(1.75rem, 4vw, 2.5rem);
  --text-3xl: clamp(2.5rem, 7vw, 4.5rem);

  --leading-tight: 1.15;
  --leading-normal: 1.6;

  --weight-regular: 400;
  --weight-medium: 500;
  --weight-bold: 700;

  --measure-text: 65ch;
  --measure-wide: 80ch;
}

/* -------------------------------------------------------------------------
   2. SEMANTIC TOKENS
   Describe WHAT a value DOES. Components reference these, never primitives.
   Default mapping = Rich Editorial theme.
   ------------------------------------------------------------------------- */
:root {
  --color-background: var(--ivory-100);
  --color-surface: var(--cream-50);

  --color-text: var(--espresso-900);
  --color-text-muted: var(--taupe-600);

  --color-border: var(--sand-300);

  --color-action: var(--burgundy-600);
  --color-action-hover: var(--burgundy-700);

  --color-focus: var(--gold-600);
}

/* -------------------------------------------------------------------------
   3. MIDNIGHT EDITORIAL — scoped alternate-theme override
   Only semantic tokens are remapped here. No component selector appears
   in this block — that is the entire point of the two-layer token system.
   ------------------------------------------------------------------------- */
[data-theme="midnight"] {
  --color-background: var(--midnight-950);
  --color-surface: var(--charcoal-900);

  --color-text: var(--ivory-100);
  --color-text-muted: var(--warm-gray-400);

  --color-border: var(--smoke-700);

  --color-action: var(--rust-500);
  --color-action-hover: var(--rust-400);

  --color-focus: var(--gold-300);
}

/* =========================================================================
   S1 — FOUNDATION + SELECTIVE RESET
   Only normalize browser behavior when there is a specific system-level
   reason to. Everything else (focus outlines, list markers, heading/
   paragraph margins, native control affordances) is intentionally kept.
   ========================================================================= */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
}

img,
svg {
  display: block;
  max-width: 100%;
}

button,
input,
select,
textarea {
  font: inherit;
}

/* -------------------------------------------------------------------------
   Base document
   ------------------------------------------------------------------------- */
html {
  color-scheme: light;
}

html[data-theme="midnight"] {
  color-scheme: dark;
}

body {
  background: var(--color-background);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* -------------------------------------------------------------------------
   Focus strategy — applies identically to every interactive element in
   both themes. Enhancement, not removal: default outlines are never
   suppressed with outline:none anywhere in this file.
   ------------------------------------------------------------------------- */
:focus-visible {
  outline: 3px solid var(--color-focus);
  outline-offset: 2px;
}

/* =========================================================================
   TYPOGRAPHY
   ========================================================================= */
h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  color: var(--color-text);
}

.display {
  font-size: var(--text-3xl);
}

h1, .h1 {
  font-size: var(--text-2xl);
}

h2, .h2 {
  font-size: var(--text-xl);
}

h3, .h3 {
  font-size: var(--text-lg);
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
}

p {
  max-width: var(--measure-text);
}

p.lead {
  font-size: var(--text-lg);
  color: var(--color-text);
}

.measure-wide {
  max-width: var(--measure-wide);
}

.text-muted {
  color: var(--color-text-muted);
}

.metadata {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

code, pre, .mono {
  font-family: var(--font-mono);
  font-size: 0.9em;
}

code {
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 0.1em 0.4em;
}

pre {
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  overflow-x: auto;
  line-height: var(--leading-normal);
}

pre code {
  border: none;
  padding: 0;
  background: none;
}

/* =========================================================================
   S4 — ACTIONS + STATES
   ========================================================================= */

/* Text links */
a {
  color: var(--color-action);
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

a:hover {
  color: var(--color-action-hover);
  text-decoration-thickness: 2px;
}

a:active {
  color: var(--color-action-hover);
}

/* Buttons — shared foundation */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
  font-family: var(--font-body);
  font-size: var(--text-base);
  font-weight: var(--weight-medium);
  padding: var(--space-sm) var(--space-lg);
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  cursor: pointer;
  text-decoration: none;
  transition: background-color 0.15s ease, color 0.15s ease,
    border-color 0.15s ease, transform 0.1s ease;
}

.btn:active {
  transform: translateY(1px);
}

.btn:disabled,
.btn[aria-disabled="true"] {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

/* Primary button */
.btn-primary {
  background: var(--color-action);
  color: var(--color-surface);
  border-color: var(--color-action);
}

.btn-primary:hover:not(:disabled) {
  background: var(--color-action-hover);
  border-color: var(--color-action-hover);
}

/* Secondary button */
.btn-secondary {
  background: transparent;
  color: var(--color-action);
  border-color: var(--color-action);
}

.btn-secondary:hover:not(:disabled) {
  background: var(--color-action);
  color: var(--color-surface);
}

/* =========================================================================
   S5 — SURFACES + CONTENT PATTERNS
   ========================================================================= */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  gap: var(--space-lg);
}

/* Pattern 1: Standard Article Card — routine editorial content */
.article-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--elevation-low);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.article-card:hover {
  box-shadow: var(--elevation-mid);
  border-color: var(--color-action);
}

.article-card h3 {
  margin: 0;
}

.article-card p {
  margin: 0;
  color: var(--color-text-muted);
}

/* Pattern 2: Featured Card — stronger elevation, media + hierarchy */
.featured-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--elevation-mid);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

/* Media placeholder — 16:9 */
.media-placeholder {
  aspect-ratio: 16 / 9;
  width: 100%;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--color-border), var(--color-background));
  border: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* Editorial callout — not styled like an error/warning */
.callout {
  background: var(--color-surface);
  border-left: 4px solid var(--color-action);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.callout h3 {
  margin: 0;
}

.callout p {
  margin: 0;
}

/* Elevation demo surfaces */
.elevation-demo {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.elevation-demo.low { box-shadow: var(--elevation-low); }
.elevation-demo.mid { box-shadow: var(--elevation-mid); }

/* Radius demo surfaces */
.radius-demo {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  padding: var(--space-lg);
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.radius-demo.sm { border-radius: var(--radius-sm); }
.radius-demo.md { border-radius: var(--radius-md); }
.radius-demo.lg { border-radius: var(--radius-lg); }

/* =========================================================================
   S6 — CONTROL FOUNDATIONS
   Basic labeled controls only. Full form design belongs to Module 3.
   ========================================================================= */
.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-lg);
  max-width: 24rem;
}

.field label,
fieldset legend {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-text);
}

.field input[type="text"],
.field select {
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: var(--space-sm) var(--space-md);
}

.checkbox-row,
.radio-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.checkbox-row label,
.radio-row label {
  font-size: var(--text-sm);
  font-weight: var(--weight-regular);
}

fieldset {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: var(--space-md);
  margin: 0 0 var(--space-lg);
  max-width: 24rem;
}

/* =========================================================================
   S2 — TOKEN INVENTORY SPECIMENS
   ========================================================================= */
.swatch {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-surface);
  font-size: var(--text-xs);
}

.swatch-color {
  height: 4.5rem;
}

.swatch-meta {
  padding: var(--space-sm) var(--space-md);
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.swatch-meta .token-name {
  font-family: var(--font-mono);
}

.spacing-demo {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.spacing-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  font-size: var(--text-sm);
}

.spacing-bar {
  height: 0.75rem;
  background: var(--color-action);
  border-radius: var(--radius-sm);
}

/* =========================================================================
   LAYOUT
   ========================================================================= */
.site-header {
  padding: var(--space-3xl) var(--space-lg) var(--space-2xl);
  border-bottom: 1px solid var(--color-border);
}

.site-header .wrap {
  max-width: 72rem;
  margin: 0 auto;
}

.brand-line {
  font-family: var(--font-display);
  font-style: italic;
  color: var(--color-text-muted);
  margin: var(--space-sm) 0 0;
}

.eyebrow {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 0 0 var(--space-sm);
}

main {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0 var(--space-lg);
}

.specimen-section {
  padding: var(--space-3xl) 0;
  border-bottom: 1px solid var(--color-border);
}

.specimen-section:last-of-type {
  border-bottom: none;
}

.section-heading {
  display: flex;
  align-items: baseline;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.section-id {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  color: var(--color-action);
  border: 1px solid var(--color-action);
  border-radius: var(--radius-sm);
  padding: 0.15em 0.5em;
  letter-spacing: 0.04em;
}

.section-intro {
  color: var(--color-text-muted);
  margin-bottom: var(--space-xl);
}

.usage-note {
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-md) var(--space-lg);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  margin-top: var(--space-lg);
}

.usage-note strong {
  color: var(--color-text);
}

.subsection {
  margin-bottom: var(--space-2xl);
}

.subsection:last-child {
  margin-bottom: 0;
}

.subsection h3 {
  margin-bottom: var(--space-sm);
}

.demo-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-lg);
  align-items: center;
  margin-bottom: var(--space-md);
}

.states-table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--text-sm);
  margin-top: var(--space-md);
}

.states-table th,
.states-table td {
  text-align: left;
  padding: var(--space-sm) var(--space-md);
  border-bottom: 1px solid var(--color-border);
}

.states-table th {
  color: var(--color-text-muted);
  font-weight: var(--weight-medium);
}

.theme-toggle {
  margin-top: var(--space-lg);
}

.site-footer {
  padding: var(--space-2xl) var(--space-lg) var(--space-3xl);
  border-top: 1px solid var(--color-border);
  background: var(--color-background);
}

.site-footer .wrap {
  max-width: 72rem;
  margin: 0 auto;
}

.site-footer h2 {
  margin-top: 0;
}

.font-test-note {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

/* Utility */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

